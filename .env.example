# Database credentials
POSTGRES_AUTH_PASSWORD=change_me
POSTGRES_DOC_PASSWORD=change_me

# MinIO credentials
MINIO_ROOT_USER=minio_user
MINIO_ROOT_PASSWORD=change_me

# Kafka configuration
